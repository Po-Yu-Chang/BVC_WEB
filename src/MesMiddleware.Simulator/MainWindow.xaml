<Window x:Class="MesMiddleware.Simulator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MesMiddleware.Simulator"
        mc:Ignorable="d"
        Title="MES Cloud Simulator (易美科 MES 系統模擬器)" Height="900" Width="1400"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <!-- 卡片樣式 -->
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="15"/>
            <Setter Property="Margin" Value="10"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#E0E0E0" Direction="270" ShadowDepth="2" Opacity="0.3" BlurRadius="8"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 按鈕樣式 -->
        <Style x:Key="ButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#3498DB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2980B9"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#BDC3C7"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Background="#F5F5F5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 頭部: 服務器狀態 -->
        <Border Grid.Row="0" Style="{StaticResource CardStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 第一行: 狀態與按鈕 -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="20" Height="20" Margin="0,0,10,0">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="Red"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsServerRunning}" Value="True">
                                            <Setter Property="Fill" Value="#2ECC71"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock VerticalAlignment="Center" Margin="0,0,20,0">
                            <Run Text="服務器狀態: " FontWeight="SemiBold"/>
                            <Run Text="{Binding IsServerRunning, Converter={StaticResource BoolToStatusConverter}}" FontWeight="Bold"/>
                        </TextBlock>
                        <TextBlock VerticalAlignment="Center">
                            <Run Text="監聽地址: " FontWeight="SemiBold"/>
                            <Run Text="{Binding ServerUrl}" Foreground="#3498DB"/>
                        </TextBlock>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Content="🚀 啟動服務器" Command="{Binding StartServerCommand}"
                                IsEnabled="{Binding IsServerRunning, Converter={StaticResource InverseBoolConverter}}"
                                Style="{StaticResource ButtonStyle}" Margin="0,0,10,0"/>
                        <Button Content="⏹️ 停止服務器" Command="{Binding StopServerCommand}"
                                IsEnabled="{Binding IsServerRunning}"
                                Style="{StaticResource ButtonStyle}" Background="#E74C3C"/>
                    </StackPanel>
                </Grid>

                <!-- 第二行: 測試 Token 顯示 -->
                <Border Grid.Row="1" Background="#FFF9E6" CornerRadius="5" Padding="10" Margin="0,10,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="🔑 測試用 Token:" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0"/>

                        <TextBox Grid.Column="1" Text="{Binding TestToken, Mode=OneWay}"
                                 IsReadOnly="True" FontFamily="Consolas" FontSize="11"
                                 Background="White" Padding="8,5" VerticalAlignment="Center"
                                 BorderBrush="#E0E0E0" BorderThickness="1"/>

                        <Button Grid.Column="2" Content="📋 複製 Token" Command="{Binding CopyTokenCommand}"
                                Style="{StaticResource ButtonStyle}" Background="#9B59B6"
                                Padding="10,5" FontSize="11" Margin="10,0,0,0"/>

                        <Button Grid.Column="3" Content="🔄 生成新 Token" Command="{Binding GenerateTestTokenCommand}"
                                IsEnabled="{Binding IsServerRunning}"
                                Style="{StaticResource ButtonStyle}" Background="#F39C12"
                                Padding="10,5" FontSize="11" Margin="5,0,0,0"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- 統計卡片 -->
        <Grid Grid.Row="1" Margin="10,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource CardStyle}" Background="#3498DB">
                <StackPanel>
                    <TextBlock Text="總請求數" Foreground="White" FontSize="13" Opacity="0.9"/>
                    <TextBlock Text="{Binding TotalRequests}" Foreground="White" FontSize="28" FontWeight="Bold" Margin="0,5,0,0"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource CardStyle}" Background="#2ECC71">
                <StackPanel>
                    <TextBlock Text="成功數" Foreground="White" FontSize="13" Opacity="0.9"/>
                    <TextBlock Text="{Binding SuccessCount}" Foreground="White" FontSize="28" FontWeight="Bold" Margin="0,5,0,0"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource CardStyle}" Background="#E74C3C">
                <StackPanel>
                    <TextBlock Text="失敗數" Foreground="White" FontSize="13" Opacity="0.9"/>
                    <TextBlock Text="{Binding FailureCount}" Foreground="White" FontSize="28" FontWeight="Bold" Margin="0,5,0,0"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="3" Style="{StaticResource CardStyle}" Background="#9B59B6">
                <StackPanel>
                    <TextBlock Text="已登錄設備" Foreground="White" FontSize="13" Opacity="0.9"/>
                    <TextBlock Text="{Binding DeviceLoginCount}" Foreground="White" FontSize="28" FontWeight="Bold" Margin="0,5,0,0"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="4" Style="{StaticResource CardStyle}" Background="#F39C12">
                <StackPanel>
                    <TextBlock Text="數據上傳數" Foreground="White" FontSize="13" Opacity="0.9"/>
                    <TextBlock Text="{Binding TraceDataCount}" Foreground="White" FontSize="28" FontWeight="Bold" Margin="0,5,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- 主內容區: 請求日誌 + 通訊詳情 -->
        <Grid Grid.Row="2" Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="3*"/>
            </Grid.ColumnDefinitions>

            <!-- 左側: 請求日誌列表 -->
            <Border Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,0,5,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="📋 請求日誌" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <Button Content="🔄 刷新" Command="{Binding RefreshDataCommand}"
                                Style="{StaticResource ButtonStyle}" Padding="10,5" FontSize="11"/>
                        <Button Content="🗑️ 清空" Command="{Binding ClearLogsCommand}"
                                Style="{StaticResource ButtonStyle}" Background="#E67E22" Padding="10,5" FontSize="11" Margin="5,0,0,0"/>
                    </StackPanel>

                    <DataGrid Grid.Row="1" ItemsSource="{Binding RequestLogs}"
                              SelectedItem="{Binding SelectedRequestLog}"
                              AutoGenerateColumns="False" IsReadOnly="True"
                              GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E8E8E8"
                              HeadersVisibility="Column" SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="時間" Binding="{Binding Timestamp, StringFormat='HH:mm:ss'}" Width="70"/>
                            <DataGridTextColumn Header="端點" Binding="{Binding Endpoint}" Width="*"/>
                            <DataGridTextColumn Header="IP" Binding="{Binding ClientIp}" Width="100"/>
                            <DataGridTextColumn Header="狀態" Binding="{Binding StatusText}" Width="50"/>
                            <DataGridTextColumn Header="耗時(ms)" Binding="{Binding ProcessingTimeMs}" Width="70"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- 右側: 通訊詳情查看器 -->
            <Border Grid.Column="1" Style="{StaticResource CardStyle}" Margin="5,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="📡 通訊詳情" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>

                    <TabControl Grid.Row="1" BorderThickness="0">
                        <TabItem Header="📤 請求 Headers">
                            <TextBox Text="{Binding SelectedRequestLog.RequestHeaders, Mode=OneWay}"
                                     IsReadOnly="True" TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="11"
                                     Background="#F8F9FA" Padding="10"/>
                        </TabItem>
                        <TabItem Header="📥 請求 Body (JSON)">
                            <TextBox Text="{Binding SelectedRequestLog.RequestBody, Mode=OneWay}"
                                     IsReadOnly="True" TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="11"
                                     Background="#F8F9FA" Padding="10"/>
                        </TabItem>
                        <TabItem Header="📤 響應 Body (JSON)">
                            <TextBox Text="{Binding SelectedRequestLog.ResponseBody, Mode=OneWay}"
                                     IsReadOnly="True" TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="11"
                                     Background="#F8F9FA" Padding="10"/>
                        </TabItem>
                    </TabControl>
                </Grid>
            </Border>
        </Grid>

        <!-- 底部: 模擬設定 -->
        <Border Grid.Row="3" Style="{StaticResource CardStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="⚙️ 模擬設定  |  模式:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,10,0"/>
                <ComboBox Grid.Column="1" SelectedValue="{Binding SimulationMode}" VerticalAlignment="Center">
                    <ComboBoxItem Content="正常響應" Tag="Normal" IsSelected="True"/>
                    <ComboBoxItem Content="總是失敗" Tag="AlwaysFail"/>
                    <ComboBoxItem Content="隨機故障" Tag="Random"/>
                    <ComboBoxItem Content="延遲響應" Tag="Delayed"/>
                </ComboBox>

                <TextBlock Grid.Column="2" Text="延遲(ms):" VerticalAlignment="Center" FontWeight="SemiBold" Margin="20,0,10,0"/>
                <Slider Grid.Column="3" Minimum="0" Maximum="5000" Value="{Binding DelayMs}" TickFrequency="100" IsSnapToTickEnabled="True" VerticalAlignment="Center"/>

                <TextBlock Grid.Column="4" Text="故障率(%):" VerticalAlignment="Center" FontWeight="SemiBold" Margin="20,0,10,0"/>
                <Slider Grid.Column="5" Minimum="0" Maximum="100" Value="{Binding FailureRate}" TickFrequency="5" IsSnapToTickEnabled="True" VerticalAlignment="Center"/>

                <Button Grid.Column="7" Content="✅ 應用設定" Command="{Binding ApplySimulationSettingsCommand}"
                        Style="{StaticResource ButtonStyle}" Background="#27AE60"/>
            </Grid>
        </Border>
    </Grid>
</Window>
