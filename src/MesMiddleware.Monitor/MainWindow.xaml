<Window x:Class="MesMiddleware.Monitor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MesMiddleware.Monitor"
        xmlns:tb="http://www.hardcodet.net/taskbar"
        mc:Ignorable="d"
        Title="MES Middleware Monitor" Height="700" Width="1200"
        WindowStartupLocation="CenterScreen"
        Closing="Window_Closing"
        StateChanged="Window_StateChanged">

    <Window.Resources>
        <!-- Card Style -->
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="15"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#E0E0E0" Direction="270" ShadowDepth="2" Opacity="0.3" BlurRadius="10"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Status Card Style - Sticky Note Effect -->
        <Style x:Key="StatusCardStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="2"/>
            <Setter Property="Padding" Value="18,15"/>
            <Setter Property="Margin" Value="12,8"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#60000000" Direction="320" ShadowDepth="6" Opacity="0.4" BlurRadius="14"/>
                </Setter.Value>
            </Setter>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <RotateTransform Angle="0.5"/>
                </Setter.Value>
            </Setter>
            <Setter Property="RenderTransformOrigin" Value="0.5,0"/>
        </Style>

        <!-- Alternate Card Rotation -->
        <Style x:Key="StatusCardStyle2" TargetType="Border" BasedOn="{StaticResource StatusCardStyle}">
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <RotateTransform Angle="-0.8"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="StatusCardStyle3" TargetType="Border" BasedOn="{StaticResource StatusCardStyle}">
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <RotateTransform Angle="1.2"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Push Pin Style -->
        <Style x:Key="PushPinStyle" TargetType="Ellipse">
            <Setter Property="Width" Value="12"/>
            <Setter Property="Height" Value="12"/>
            <Setter Property="Fill">
                <Setter.Value>
                    <RadialGradientBrush>
                        <GradientStop Color="#E74C3C" Offset="0"/>
                        <GradientStop Color="#C0392B" Offset="1"/>
                    </RadialGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#80000000" Direction="315" ShadowDepth="2" Opacity="0.6" BlurRadius="4"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Curled Corner Style - Enhanced -->
        <Style x:Key="CurledCornerStyle" TargetType="Canvas">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Bottom"/>
            <Setter Property="Margin" Value="0,0,-2,-2"/>
        </Style>

        <!-- Curled Corner Shadow Path -->
        <PathGeometry x:Key="CurledCornerGeometry">M 0,40 L 40,40 L 40,0 Q 30,15 0,40 Z</PathGeometry>

        <!-- Title Style -->
        <Style x:Key="TitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#2C3E50"/>
            <Setter Property="Margin" Value="0,0,0,15"/>
        </Style>

        <!-- Label Style -->
        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#7F8C8D"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>

        <!-- Value Style -->
        <Style x:Key="ValueStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#2C3E50"/>
        </Style>

        <!-- Button Style -->
        <Style x:Key="ModernButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#3498DB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2980B9"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Tab Control Style -->
        <Style TargetType="TabControl">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border Name="Border"
                                Background="White"
                                BorderThickness="0"
                                CornerRadius="8,8,0,0"
                                Padding="20,12"
                                Margin="2,0">
                            <ContentPresenter x:Name="ContentSite"
                                            VerticalAlignment="Center"
                                            HorizontalAlignment="Center"
                                            ContentSource="Header"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#3498DB"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="False">
                                <Setter Property="Foreground" Value="#7F8C8D"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#ECF0F1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- DataGrid Style -->
        <Style TargetType="DataGrid">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="RowBackground" Value="White"/>
            <Setter Property="AlternatingRowBackground" Value="#F8F9FA"/>
            <Setter Property="GridLinesVisibility" Value="None"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#34495E"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <!-- Cork Board Background -->
    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#D4A574" Offset="0"/>
                <GradientStop Color="#C49A6C" Offset="0.5"/>
                <GradientStop Color="#B8915F" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>

        <!-- Add Cork Texture Pattern with Granular Detail -->
        <Rectangle>
            <Rectangle.Fill>
                <DrawingBrush TileMode="Tile" Viewport="0,0,50,50" ViewportUnits="Absolute">
                    <DrawingBrush.Drawing>
                        <DrawingGroup>
                            <!-- Dark spots - cork grain -->
                            <GeometryDrawing Brush="#44000000">
                                <GeometryDrawing.Geometry>
                                    <EllipseGeometry Center="5,5" RadiusX="1.5" RadiusY="1"/>
                                </GeometryDrawing.Geometry>
                            </GeometryDrawing>
                            <GeometryDrawing Brush="#33000000">
                                <GeometryDrawing.Geometry>
                                    <EllipseGeometry Center="15,12" RadiusX="2" RadiusY="1.5"/>
                                </GeometryDrawing.Geometry>
                            </GeometryDrawing>
                            <GeometryDrawing Brush="#22000000">
                                <GeometryDrawing.Geometry>
                                    <EllipseGeometry Center="30,8" RadiusX="1" RadiusY="0.5"/>
                                </GeometryDrawing.Geometry>
                            </GeometryDrawing>
                            <GeometryDrawing Brush="#44000000">
                                <GeometryDrawing.Geometry>
                                    <EllipseGeometry Center="42,15" RadiusX="1.5" RadiusY="1"/>
                                </GeometryDrawing.Geometry>
                            </GeometryDrawing>
                            <GeometryDrawing Brush="#33000000">
                                <GeometryDrawing.Geometry>
                                    <EllipseGeometry Center="8,25" RadiusX="2.5" RadiusY="1.5"/>
                                </GeometryDrawing.Geometry>
                            </GeometryDrawing>
                            <GeometryDrawing Brush="#22000000">
                                <GeometryDrawing.Geometry>
                                    <EllipseGeometry Center="25,30" RadiusX="1" RadiusY="1"/>
                                </GeometryDrawing.Geometry>
                            </GeometryDrawing>
                            <GeometryDrawing Brush="#33000000">
                                <GeometryDrawing.Geometry>
                                    <EllipseGeometry Center="38,28" RadiusX="1.5" RadiusY="2"/>
                                </GeometryDrawing.Geometry>
                            </GeometryDrawing>
                            <GeometryDrawing Brush="#22000000">
                                <GeometryDrawing.Geometry>
                                    <EllipseGeometry Center="18,38" RadiusX="0.8" RadiusY="0.8"/>
                                </GeometryDrawing.Geometry>
                            </GeometryDrawing>
                            <GeometryDrawing Brush="#44000000">
                                <GeometryDrawing.Geometry>
                                    <EllipseGeometry Center="35,42" RadiusX="2" RadiusY="1.5"/>
                                </GeometryDrawing.Geometry>
                            </GeometryDrawing>
                            <GeometryDrawing Brush="#22000000">
                                <GeometryDrawing.Geometry>
                                    <EllipseGeometry Center="12,45" RadiusX="1" RadiusY="1.5"/>
                                </GeometryDrawing.Geometry>
                            </GeometryDrawing>
                            <!-- Light spots - highlights -->
                            <GeometryDrawing Brush="#11FFFFFF">
                                <GeometryDrawing.Geometry>
                                    <EllipseGeometry Center="20,18" RadiusX="3" RadiusY="2"/>
                                </GeometryDrawing.Geometry>
                            </GeometryDrawing>
                            <GeometryDrawing Brush="#11FFFFFF">
                                <GeometryDrawing.Geometry>
                                    <EllipseGeometry Center="40,35" RadiusX="2.5" RadiusY="2.5"/>
                                </GeometryDrawing.Geometry>
                            </GeometryDrawing>
                            <GeometryDrawing Brush="#11FFFFFF">
                                <GeometryDrawing.Geometry>
                                    <EllipseGeometry Center="10,40" RadiusX="2" RadiusY="3"/>
                                </GeometryDrawing.Geometry>
                            </GeometryDrawing>
                        </DrawingGroup>
                    </DrawingBrush.Drawing>
                </DrawingBrush>
            </Rectangle.Fill>
        </Rectangle>

        <!-- Add subtle noise overlay for more texture -->
        <Rectangle Opacity="0.03">
            <Rectangle.Fill>
                <DrawingBrush TileMode="Tile" Viewport="0,0,2,2" ViewportUnits="Absolute">
                    <DrawingBrush.Drawing>
                        <GeometryDrawing Brush="Black">
                            <GeometryDrawing.Geometry>
                                <RectangleGeometry Rect="0,0,1,1"/>
                            </GeometryDrawing.Geometry>
                        </GeometryDrawing>
                    </DrawingBrush.Drawing>
                </DrawingBrush>
            </Rectangle.Fill>
        </Rectangle>

        <!-- Content Grid -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header - Pinned Note Style -->
            <Border Grid.Row="0" Height="120" Margin="20,15,20,10" CornerRadius="4">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#3498DB" Offset="0"/>
                    <GradientStop Color="#2ECC71" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Border.Effect>
                <DropShadowEffect Color="#60000000" Direction="315" ShadowDepth="8" Opacity="0.6" BlurRadius="15"/>
            </Border.Effect>

            <Grid>
                <!-- Push Pins at Top -->
                <Canvas>
                    <Ellipse Style="{StaticResource PushPinStyle}" Canvas.Left="30" Canvas.Top="-6"/>
                    <Ellipse Style="{StaticResource PushPinStyle}" Canvas.Right="30" Canvas.Top="-6"/>
                </Canvas>

                <StackPanel VerticalAlignment="Center" Margin="30,0">
                    <TextBlock Text="🎯 MES MIDDLEWARE"
                               FontSize="32"
                               FontWeight="Bold"
                               Foreground="White"
                               Margin="0,0,0,5"
                               TextAlignment="Center"/>
                    <TextBlock Text="Real-time Monitoring Dashboard"
                               FontSize="15"
                               Foreground="#ECF0F1"
                               Opacity="0.95"
                               TextAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content with Cork Texture -->
        <Border Grid.Row="1" Margin="10" CornerRadius="8">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#E5C9A6" Offset="0"/>
                    <GradientStop Color="#D4B898" Offset="0.5"/>
                    <GradientStop Color="#C4A888" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Border.Effect>
                <DropShadowEffect Color="#60000000" Direction="315" ShadowDepth="6" Opacity="0.4" BlurRadius="12"/>
            </Border.Effect>

            <Grid>
                <!-- Add granular texture to TabControl area -->
                <Rectangle>
                    <Rectangle.Fill>
                        <DrawingBrush TileMode="Tile" Viewport="0,0,40,40" ViewportUnits="Absolute">
                            <DrawingBrush.Drawing>
                                <DrawingGroup>
                                    <GeometryDrawing Brush="#33000000">
                                        <GeometryDrawing.Geometry>
                                            <EllipseGeometry Center="5,8" RadiusX="1" RadiusY="0.8"/>
                                        </GeometryDrawing.Geometry>
                                    </GeometryDrawing>
                                    <GeometryDrawing Brush="#22000000">
                                        <GeometryDrawing.Geometry>
                                            <EllipseGeometry Center="18,5" RadiusX="1.2" RadiusY="1"/>
                                        </GeometryDrawing.Geometry>
                                    </GeometryDrawing>
                                    <GeometryDrawing Brush="#22000000">
                                        <GeometryDrawing.Geometry>
                                            <EllipseGeometry Center="30,15" RadiusX="0.8" RadiusY="0.8"/>
                                        </GeometryDrawing.Geometry>
                                    </GeometryDrawing>
                                    <GeometryDrawing Brush="#33000000">
                                        <GeometryDrawing.Geometry>
                                            <EllipseGeometry Center="12,22" RadiusX="1.5" RadiusY="1.2"/>
                                        </GeometryDrawing.Geometry>
                                    </GeometryDrawing>
                                    <GeometryDrawing Brush="#22000000">
                                        <GeometryDrawing.Geometry>
                                            <EllipseGeometry Center="25,28" RadiusX="0.9" RadiusY="1.1"/>
                                        </GeometryDrawing.Geometry>
                                    </GeometryDrawing>
                                    <GeometryDrawing Brush="#11FFFFFF">
                                        <GeometryDrawing.Geometry>
                                            <EllipseGeometry Center="15,12" RadiusX="2" RadiusY="1.5"/>
                                        </GeometryDrawing.Geometry>
                                    </GeometryDrawing>
                                    <GeometryDrawing Brush="#11FFFFFF">
                                        <GeometryDrawing.Geometry>
                                            <EllipseGeometry Center="32,25" RadiusX="1.8" RadiusY="1.8"/>
                                        </GeometryDrawing.Geometry>
                                    </GeometryDrawing>
                                </DrawingGroup>
                            </DrawingBrush.Drawing>
                        </DrawingBrush>
                    </Rectangle.Fill>
                </Rectangle>

                <TabControl Margin="10">
                    <!-- Status Tab -->
                    <TabItem Header="📊 系統狀態">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="10">
                    <StackPanel>
                        <!-- Service Status Cards -->
                        <TextBlock Text="服務狀態" Style="{StaticResource TitleStyle}" Margin="20,10,0,10"/>
                        <UniformGrid Columns="3" Margin="5,0">
                            <!-- Service Running Card -->
                            <Grid>
                                <Border Style="{StaticResource StatusCardStyle}">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#E74C3C" Offset="0"/>
                                            <GradientStop Color="#C0392B" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <Grid>
                                        <StackPanel>
                                            <TextBlock Text="🔴 服務運行" Style="{StaticResource LabelStyle}" Foreground="White" Opacity="0.9"/>
                                            <TextBlock Text="{Binding StatusViewModel.IsRunning}" Style="{StaticResource ValueStyle}" Foreground="White" FontSize="24"/>
                                        </StackPanel>
                                        <!-- Curled Corner -->
                                        <Canvas Style="{StaticResource CurledCornerStyle}">
                                            <!-- Shadow layer -->
                                            <Path Data="{StaticResource CurledCornerGeometry}" Opacity="0.3">
                                                <Path.Fill>
                                                    <LinearGradientBrush StartPoint="0,1" EndPoint="1,0">
                                                        <GradientStop Color="#80000000" Offset="0"/>
                                                        <GradientStop Color="#40000000" Offset="0.6"/>
                                                        <GradientStop Color="Transparent" Offset="1"/>
                                                    </LinearGradientBrush>
                                                </Path.Fill>
                                            </Path>
                                            <!-- Highlight layer -->
                                            <Path Data="{StaticResource CurledCornerGeometry}" Canvas.Left="1" Canvas.Top="1" Opacity="0.5">
                                                <Path.Fill>
                                                    <LinearGradientBrush StartPoint="1,0" EndPoint="0,1">
                                                        <GradientStop Color="#60FFFFFF" Offset="0.7"/>
                                                        <GradientStop Color="Transparent" Offset="1"/>
                                                    </LinearGradientBrush>
                                                </Path.Fill>
                                            </Path>
                                        </Canvas>
                                    </Grid>
                                </Border>
                                <Ellipse Style="{StaticResource PushPinStyle}" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,-6,0,0"/>
                            </Grid>

                            <!-- WebAPI Connected Card -->
                            <Grid>
                                <Border Style="{StaticResource StatusCardStyle2}">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#3498DB" Offset="0"/>
                                            <GradientStop Color="#2980B9" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <StackPanel>
                                        <TextBlock Text="🌐 WebAPI 連接" Style="{StaticResource LabelStyle}" Foreground="White" Opacity="0.9"/>
                                        <TextBlock Text="{Binding StatusViewModel.IsWebApiConnected}" Style="{StaticResource ValueStyle}" Foreground="White" FontSize="24"/>
                                    </StackPanel>
                                </Border>
                                <Ellipse Style="{StaticResource PushPinStyle}" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,-6,0,0"/>
                            </Grid>

                            <!-- Shared Memory Card -->
                            <Grid>
                                <Border Style="{StaticResource StatusCardStyle3}">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#9B59B6" Offset="0"/>
                                            <GradientStop Color="#8E44AD" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <StackPanel>
                                        <TextBlock Text="💾 共享記憶體" Style="{StaticResource LabelStyle}" Foreground="White" Opacity="0.9"/>
                                        <TextBlock Text="{Binding StatusViewModel.IsSharedMemoryActive}" Style="{StaticResource ValueStyle}" Foreground="White" FontSize="24"/>
                                    </StackPanel>
                                </Border>
                                <Ellipse Style="{StaticResource PushPinStyle}" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,-6,0,0"/>
                            </Grid>
                        </UniformGrid>

                        <!-- Statistics Cards -->
                        <TextBlock Text="數據統計" Style="{StaticResource TitleStyle}" Margin="20,20,0,10"/>
                        <UniformGrid Columns="3" Margin="5,0">
                            <!-- Total Received -->
                            <Grid>
                                <Border Style="{StaticResource StatusCardStyle2}">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#2ECC71" Offset="0"/>
                                            <GradientStop Color="#27AE60" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <StackPanel>
                                        <TextBlock Text="📥 總接收數據" Style="{StaticResource LabelStyle}" Foreground="White" Opacity="0.9"/>
                                        <TextBlock Text="{Binding StatusViewModel.TotalDataReceived}" Style="{StaticResource ValueStyle}" Foreground="White" FontSize="32"/>
                                    </StackPanel>
                                </Border>
                                <Ellipse Style="{StaticResource PushPinStyle}" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,-6,0,0"/>
                            </Grid>

                            <!-- Successful Uploads -->
                            <Grid>
                                <Border Style="{StaticResource StatusCardStyle3}">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#F39C12" Offset="0"/>
                                            <GradientStop Color="#E67E22" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <StackPanel>
                                        <TextBlock Text="✅ 成功上傳" Style="{StaticResource LabelStyle}" Foreground="White" Opacity="0.9"/>
                                        <TextBlock Text="{Binding StatusViewModel.SuccessfulUploads}" Style="{StaticResource ValueStyle}" Foreground="White" FontSize="32"/>
                                    </StackPanel>
                                </Border>
                                <Ellipse Style="{StaticResource PushPinStyle}" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,-6,0,0"/>
                            </Grid>

                            <!-- Queued Uploads -->
                            <Grid>
                                <Border Style="{StaticResource StatusCardStyle}">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#1ABC9C" Offset="0"/>
                                            <GradientStop Color="#16A085" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <StackPanel>
                                        <TextBlock Text="⏳ 佇列中" Style="{StaticResource LabelStyle}" Foreground="White" Opacity="0.9"/>
                                        <TextBlock Text="{Binding StatusViewModel.QueuedUploads}" Style="{StaticResource ValueStyle}" Foreground="White" FontSize="32"/>
                                    </StackPanel>
                                </Border>
                                <Ellipse Style="{StaticResource PushPinStyle}" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,-6,0,0"/>
                            </Grid>
                        </UniformGrid>

                        <!-- System Info Card -->
                        <Grid Margin="15,20">
                            <Border Style="{StaticResource CardStyle}" Margin="0">
                                <Border.RenderTransform>
                                    <RotateTransform Angle="-0.5"/>
                                </Border.RenderTransform>
                                <Border.RenderTransformOrigin>0.5,0</Border.RenderTransformOrigin>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="⏱️ 運行時間" Style="{StaticResource LabelStyle}"/>
                                    <TextBlock Text="{Binding StatusViewModel.Uptime}" Style="{StaticResource ValueStyle}" FontSize="18" Margin="0,5,0,15"/>

                                    <TextBlock Text="🕐 最後更新" Style="{StaticResource LabelStyle}"/>
                                    <TextBlock Text="{Binding StatusViewModel.LastUpdated, StringFormat='yyyy-MM-dd HH:mm:ss'}"
                                               Style="{StaticResource ValueStyle}" FontSize="14" Margin="0,5,0,0"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="⚠️ 最後錯誤" Style="{StaticResource LabelStyle}"/>
                                    <TextBlock Text="{Binding StatusViewModel.LastError}"
                                               TextWrapping="Wrap"
                                               Foreground="#E74C3C"
                                               FontSize="13"
                                               Margin="0,5,0,0"/>
                                </StackPanel>
                            </Grid>
                            </Border>
                            <Ellipse Style="{StaticResource PushPinStyle}" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,-6,0,0"/>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Queue Status Tab -->
            <TabItem Header="📦 佇列狀態">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="10">
                    <StackPanel>
                        <TextBlock Text="上傳佇列" Style="{StaticResource TitleStyle}" Margin="20,10,0,10"/>
                        <UniformGrid Columns="2" Rows="3" Margin="5,0">
                            <!-- Pending -->
                            <Grid>
                                <Border Style="{StaticResource StatusCardStyle2}">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#3498DB" Offset="0"/>
                                            <GradientStop Color="#2980B9" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <StackPanel>
                                        <TextBlock Text="📋 待處理" Style="{StaticResource LabelStyle}" Foreground="White" Opacity="0.9"/>
                                        <TextBlock Text="{Binding QueueViewModel.PendingCount}" Style="{StaticResource ValueStyle}" Foreground="White" FontSize="36"/>
                                    </StackPanel>
                                </Border>
                                <Ellipse Style="{StaticResource PushPinStyle}" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,-6,0,0"/>
                            </Grid>

                            <!-- Retrying -->
                            <Grid>
                                <Border Style="{StaticResource StatusCardStyle3}">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#F39C12" Offset="0"/>
                                            <GradientStop Color="#E67E22" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <StackPanel>
                                        <TextBlock Text="🔄 重試中" Style="{StaticResource LabelStyle}" Foreground="White" Opacity="0.9"/>
                                        <TextBlock Text="{Binding QueueViewModel.RetryingCount}" Style="{StaticResource ValueStyle}" Foreground="White" FontSize="36"/>
                                    </StackPanel>
                                </Border>
                                <Ellipse Style="{StaticResource PushPinStyle}" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,-6,0,0"/>
                            </Grid>

                            <!-- Failed -->
                            <Grid>
                                <Border Style="{StaticResource StatusCardStyle}">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#E74C3C" Offset="0"/>
                                            <GradientStop Color="#C0392B" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <StackPanel>
                                        <TextBlock Text="❌ 失敗" Style="{StaticResource LabelStyle}" Foreground="White" Opacity="0.9"/>
                                        <TextBlock Text="{Binding QueueViewModel.FailedCount}" Style="{StaticResource ValueStyle}" Foreground="White" FontSize="36"/>
                                    </StackPanel>
                                </Border>
                                <Ellipse Style="{StaticResource PushPinStyle}" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,-6,0,0"/>
                            </Grid>

                            <!-- Total Depth -->
                            <Grid>
                                <Border Style="{StaticResource StatusCardStyle2}">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#9B59B6" Offset="0"/>
                                            <GradientStop Color="#8E44AD" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <StackPanel>
                                        <TextBlock Text="📊 總深度" Style="{StaticResource LabelStyle}" Foreground="White" Opacity="0.9"/>
                                        <TextBlock Text="{Binding QueueViewModel.TotalDepth}" Style="{StaticResource ValueStyle}" Foreground="White" FontSize="36"/>
                                    </StackPanel>
                                </Border>
                                <Ellipse Style="{StaticResource PushPinStyle}" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,-6,0,0"/>
                            </Grid>
                        </UniformGrid>

                        <!-- Oldest Queued Info -->
                        <Grid Margin="15,20">
                            <Border Style="{StaticResource CardStyle}" Margin="0">
                                <Border.RenderTransform>
                                    <RotateTransform Angle="0.8"/>
                                </Border.RenderTransform>
                                <Border.RenderTransformOrigin>0.5,0</Border.RenderTransformOrigin>
                                <StackPanel>
                                    <TextBlock Text="⏰ 最舊佇列項目" Style="{StaticResource LabelStyle}"/>
                                    <TextBlock Text="{Binding QueueViewModel.OldestQueuedAt}"
                                               Style="{StaticResource ValueStyle}"
                                               FontSize="16"
                                               Margin="0,5,0,0"/>
                                </StackPanel>
                            </Border>
                            <Ellipse Style="{StaticResource PushPinStyle}" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,-6,0,0"/>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Upload History Tab -->
            <TabItem Header="📜 上傳歷史">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Refresh Button -->
                    <Border Grid.Row="0" Background="White" Padding="15" Margin="15,15,15,0" CornerRadius="8,8,0,0">
                        <Button Content="🔄 重新整理"
                                Command="{Binding HistoryViewModel.RefreshCommand}"
                                Style="{StaticResource ModernButtonStyle}"
                                HorizontalAlignment="Right"/>
                    </Border>

                    <!-- Data Grid -->
                    <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="15,0,15,15" Padding="0" CornerRadius="0,0,8,8">
                        <DataGrid ItemsSource="{Binding HistoryViewModel.HistoryItems}"
                                  IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="⏰ 時間戳記" Binding="{Binding Timestamp, StringFormat='yyyy-MM-dd HH:mm:ss'}" Width="160"/>
                                <DataGridTextColumn Header="🏷️ 追溯碼/批號" Binding="{Binding TraceCodeOrLotNo}" Width="150"/>
                                <DataGridTextColumn Header="🖥️ 設備" Binding="{Binding DeviceName}" Width="130"/>
                                <DataGridTextColumn Header="📊 狀態" Binding="{Binding Status}" Width="100"/>
                                <DataGridTextColumn Header="🔄 重試次數" Binding="{Binding RetryCount}" Width="100"/>
                                <DataGridTextColumn Header="⚠️ 錯誤訊息" Binding="{Binding ErrorMessage}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>
            </Grid>
        </Border>
        </Grid>
    </Grid>
</Window>
