<Window x:Class="MesMiddleware.Monitor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MesMiddleware.Monitor"
        xmlns:views="clr-namespace:MesMiddleware.Monitor.Views"
        xmlns:tb="http://www.hardcodet.net/taskbar"
        mc:Ignorable="d"
        Title="{Binding WindowTitle}" Height="700" Width="1200"
        WindowStartupLocation="CenterScreen"
        Closing="Window_Closing"
        StateChanged="Window_StateChanged">

    <Window.Resources>
        <!-- Card Style -->
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="15"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#E0E0E0" Direction="270" ShadowDepth="2" Opacity="0.3" BlurRadius="10"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Status Card Style - Sticky Note Effect -->
        <Style x:Key="StatusCardStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="18,15"/>
            <Setter Property="Margin" Value="12,8"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#60000000" Direction="320" ShadowDepth="4" Opacity="0.2" BlurRadius="10"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Alternate Card Rotation -->
        <Style x:Key="StatusCardStyle2" TargetType="Border" BasedOn="{StaticResource StatusCardStyle}"/>

        <Style x:Key="StatusCardStyle3" TargetType="Border" BasedOn="{StaticResource StatusCardStyle}"/>

        <!-- Push Pin Style (Hidden for Modern Look) -->
        <Style x:Key="PushPinStyle" TargetType="Ellipse">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Setter Property="Width" Value="12"/>
            <Setter Property="Height" Value="12"/>
            <Setter Property="Fill">
                <Setter.Value>
                    <RadialGradientBrush>
                        <GradientStop Color="#E74C3C" Offset="0"/>
                        <GradientStop Color="#C0392B" Offset="1"/>
                    </RadialGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#80000000" Direction="315" ShadowDepth="2" Opacity="0.6" BlurRadius="4"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Curled Corner Effect (Hidden for Modern Look) -->
        <Style x:Key="CurledCornerStyle" TargetType="Canvas">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Bottom"/>
            <Setter Property="Width" Value="50"/>
            <Setter Property="Height" Value="50"/>
            <Setter Property="Margin" Value="0,0,-18,-15"/>
        </Style>

        <!-- Back Triangle (Folded underside - darker) -->
        <PathGeometry x:Key="FoldBackGeometry">M 0,50 L 50,50 L 50,0 Z</PathGeometry>

        <!-- Front Triangle (Visible curl - lighter with gradient) -->
        <PathGeometry x:Key="FoldFrontGeometry">M 0,50 L 50,50 L 50,0 Z</PathGeometry>

        <!-- Title Style -->
        <Style x:Key="TitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#2C3E50"/>
            <Setter Property="Margin" Value="0,0,0,15"/>
        </Style>

        <!-- Label Style -->
        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#7F8C8D"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>

        <!-- Value Style -->
        <Style x:Key="ValueStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#2C3E50"/>
        </Style>

        <!-- Button Style -->
        <Style x:Key="ModernButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#3498DB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2980B9"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Tab Control Style -->
        <Style TargetType="TabControl">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border Name="Border"
                                Background="#E8E8E8"
                                BorderThickness="0,0,0,3"
                                BorderBrush="Transparent"
                                CornerRadius="8,8,0,0"
                                Padding="24,14"
                                Margin="4,0">
                            <Border.Effect>
                                <DropShadowEffect Color="#30000000" Direction="270" ShadowDepth="1" Opacity="0.3" BlurRadius="3"/>
                            </Border.Effect>
                            <ContentPresenter x:Name="ContentSite"
                                            VerticalAlignment="Center"
                                            HorizontalAlignment="Center"
                                            ContentSource="Header"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#3498DB"/>
                                <Setter TargetName="Border" Property="BorderBrush" Value="#2980B9"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="False">
                                <Setter Property="Foreground" Value="#5A5A5A"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="IsSelected" Value="False"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Border" Property="Background" Value="#D5DBDB"/>
                                <Setter Property="Foreground" Value="#2C3E50"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- DataGrid Style -->
        <Style TargetType="DataGrid">
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#BDC3C7"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="RowBackground" Value="White"/>
            <Setter Property="AlternatingRowBackground" Value="#ECF0F1"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#E8E8E8"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#2C3E50"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="12,12"/>
            <Setter Property="BorderThickness" Value="0,0,1,0"/>
            <Setter Property="BorderBrush" Value="#34495E"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="#2C3E50"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#3498DB"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="DataGridRow">
            <Setter Property="Height" Value="40"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#D5DBDB"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#3498DB"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <!-- Background - Wygins+ Style -->
    <Grid Background="#F5F1E8">
        <!-- Content Grid -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header - Pinned Note Style -->
            <Border Grid.Row="0" Height="120" Margin="20,15,20,10" CornerRadius="4">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#3498DB" Offset="0"/>
                    <GradientStop Color="#2ECC71" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Border.Effect>
                <DropShadowEffect Color="#60000000" Direction="315" ShadowDepth="8" Opacity="0.6" BlurRadius="15"/>
            </Border.Effect>

            <Grid>
                <!-- Push Pins at Top -->
                <Canvas>
                    <Ellipse Style="{StaticResource PushPinStyle}" Canvas.Left="30" Canvas.Top="-6"/>
                    <Ellipse Style="{StaticResource PushPinStyle}" Canvas.Right="30" Canvas.Top="-6"/>
                </Canvas>

                <StackPanel VerticalAlignment="Center" Margin="30,0">
                    <TextBlock Text="{Binding HeaderTitle}"
                               FontSize="32"
                               FontWeight="Bold"
                               Foreground="White"
                               Margin="0,0,0,5"
                               TextAlignment="Center"/>
                    <TextBlock Text="{Binding HeaderSubtitle}"
                               FontSize="15"
                               Foreground="#ECF0F1"
                               Opacity="0.95"
                               TextAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content with Cork Texture -->
        <Border Grid.Row="1" Margin="10" CornerRadius="8">
            <Border.Background>
                <SolidColorBrush Color="#F0FFFFFF"/>
            </Border.Background>
            <Border.Effect>
                <DropShadowEffect Color="#60000000" Direction="315" ShadowDepth="6" Opacity="0.4" BlurRadius="12"/>
            </Border.Effect>

            <Grid>


                <!-- Language Switcher -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="20,10">
                    <TextBlock Text="{Binding LanguageTitle}"
                               VerticalAlignment="Center"
                               Margin="0,0,10,0"
                               FontWeight="SemiBold"
                               Foreground="#2C3E50"
                               FontSize="14"/>
                    <Button Content="{Binding LanguageEnglish}"
                            Command="{Binding ChangeLanguageCommand}"
                            CommandParameter="en"
                            Style="{StaticResource ModernButtonStyle}"
                            Margin="5,0"
                            Padding="15,8"
                            FontSize="12"/>
                    <Button Content="{Binding LanguageSimplifiedChinese}"
                            Command="{Binding ChangeLanguageCommand}"
                            CommandParameter="zh-CN"
                            Style="{StaticResource ModernButtonStyle}"
                            Margin="5,0"
                            Padding="15,8"
                            FontSize="12"/>
                    <Button Content="{Binding LanguageTraditionalChinese}"
                            Command="{Binding ChangeLanguageCommand}"
                            CommandParameter="zh-TW"
                            Style="{StaticResource ModernButtonStyle}"
                            Margin="5,0"
                            Padding="15,8"
                            FontSize="12"/>
                </StackPanel>

                <TabControl Margin="10,60,10,10">
                    <!-- Status Tab -->
                    <TabItem Header="{Binding TabStatus}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="10">
                    <StackPanel>
                        <!-- Service Status Cards -->
                        <TextBlock Text="{Binding StatusSectionTitle}" Style="{StaticResource TitleStyle}" Margin="20,10,0,10"/>
                        <UniformGrid Columns="2" Margin="5,0">
                            <!-- Equipment → Middleware Connection Card -->
                            <Grid>
                                <Border Style="{StaticResource StatusCardStyle}">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#9B59B6" Offset="0"/>
                                            <GradientStop Color="#8E44AD" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <Grid>
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock Text="設備 → 中介軟體" Style="{StaticResource LabelStyle}" Foreground="White" Opacity="0.9" TextAlignment="Center" Margin="0,0,0,15"/>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <Ellipse Width="50" Height="50" Margin="0,0,15,0">
                                                    <Ellipse.Style>
                                                        <Style TargetType="Ellipse">
                                                            <Setter Property="Fill" Value="#95A5A6"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding StatusViewModel.IsRunning}" Value="True">
                                                                    <Setter Property="Fill" Value="#2ECC71"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding StatusViewModel.IsRunning}" Value="False">
                                                                    <Setter Property="Fill" Value="#E74C3C"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Ellipse.Style>
                                                    <Ellipse.Effect>
                                                        <DropShadowEffect Color="#40000000" Direction="315" ShadowDepth="3" Opacity="0.5" BlurRadius="8"/>
                                                    </Ellipse.Effect>
                                                </Ellipse>
                                                <TextBlock VerticalAlignment="Center" Foreground="White" FontSize="20" FontWeight="SemiBold">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value="未連線"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding StatusViewModel.IsRunning}" Value="True">
                                                                    <Setter Property="Text" Value="已連線"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                        </StackPanel>
                                        <!-- Curled Corner - Dual Layer Effect -->
                                        <Canvas Style="{StaticResource CurledCornerStyle}">
                                            <!-- Back layer - darker underside of fold -->
                                            <Path Data="{StaticResource FoldBackGeometry}" Fill="#30000000"/>
                                            <!-- Front layer - visible curl with gradient -->
                                            <Path Data="{StaticResource FoldFrontGeometry}">
                                                <Path.Fill>
                                                    <LinearGradientBrush StartPoint="0,1" EndPoint="1,0">
                                                        <GradientStop Color="#A0000000" Offset="0"/>
                                                        <GradientStop Color="#60000000" Offset="0.3"/>
                                                        <GradientStop Color="#30000000" Offset="0.6"/>
                                                        <GradientStop Color="Transparent" Offset="1"/>
                                                    </LinearGradientBrush>
                                                </Path.Fill>
                                                <Path.Effect>
                                                    <DropShadowEffect Color="#80000000" Direction="315" ShadowDepth="3" Opacity="0.6" BlurRadius="5"/>
                                                </Path.Effect>
                                            </Path>
                                        </Canvas>
                                    </Grid>
                                </Border>
                                <Ellipse Style="{StaticResource PushPinStyle}" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,-6,0,0"/>
                            </Grid>

                            <!-- Middleware → MES Cloud Connection Card -->
                            <Grid>
                                <Border Style="{StaticResource StatusCardStyle2}">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#3498DB" Offset="0"/>
                                            <GradientStop Color="#2980B9" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <Grid>
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock Text="中介軟體 → MES Cloud" Style="{StaticResource LabelStyle}" Foreground="White" Opacity="0.9" TextAlignment="Center" Margin="0,0,0,15"/>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <Ellipse Width="50" Height="50" Margin="0,0,15,0">
                                                    <Ellipse.Style>
                                                        <Style TargetType="Ellipse">
                                                            <Setter Property="Fill" Value="#95A5A6"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding StatusViewModel.IsWebApiConnected}" Value="True">
                                                                    <Setter Property="Fill" Value="#2ECC71"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding StatusViewModel.IsWebApiConnected}" Value="False">
                                                                    <Setter Property="Fill" Value="#E74C3C"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Ellipse.Style>
                                                    <Ellipse.Effect>
                                                        <DropShadowEffect Color="#40000000" Direction="315" ShadowDepth="3" Opacity="0.5" BlurRadius="8"/>
                                                    </Ellipse.Effect>
                                                </Ellipse>
                                                <TextBlock VerticalAlignment="Center" Foreground="White" FontSize="20" FontWeight="SemiBold">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value="未連線"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding StatusViewModel.IsWebApiConnected}" Value="True">
                                                                    <Setter Property="Text" Value="已連線"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                        </StackPanel>
                                        <Canvas Style="{StaticResource CurledCornerStyle}">
                                            <Path Data="{StaticResource FoldBackGeometry}" Fill="#30000000"/>
                                            <Path Data="{StaticResource FoldFrontGeometry}">
                                                <Path.Fill>
                                                    <LinearGradientBrush StartPoint="0,1" EndPoint="1,0">
                                                        <GradientStop Color="#A0000000" Offset="0"/>
                                                        <GradientStop Color="#60000000" Offset="0.3"/>
                                                        <GradientStop Color="#30000000" Offset="0.6"/>
                                                        <GradientStop Color="Transparent" Offset="1"/>
                                                    </LinearGradientBrush>
                                                </Path.Fill>
                                                <Path.Effect>
                                                    <DropShadowEffect Color="#80000000" Direction="315" ShadowDepth="3" Opacity="0.6" BlurRadius="5"/>
                                                </Path.Effect>
                                            </Path>
                                        </Canvas>
                                    </Grid>
                                </Border>
                                <Ellipse Style="{StaticResource PushPinStyle}" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,-6,0,0"/>
                            </Grid>
                        </UniformGrid>

                        <!-- Statistics Cards -->
                        <TextBlock Text="{Binding StatusStatisticsTitle}" Style="{StaticResource TitleStyle}" Margin="20,20,0,10"/>
                        <UniformGrid Columns="3" Margin="5,0">
                            <!-- Total Received -->
                            <Grid>
                                <Border Style="{StaticResource StatusCardStyle2}">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#2ECC71" Offset="0"/>
                                            <GradientStop Color="#27AE60" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <Grid>
                                        <StackPanel>
                                            <TextBlock Text="{Binding StatusTotalReceived}" Style="{StaticResource LabelStyle}" Foreground="White" Opacity="0.9"/>
                                            <TextBlock Text="{Binding StatusViewModel.TotalDataReceived}" Style="{StaticResource ValueStyle}" Foreground="White" FontSize="32"/>
                                        </StackPanel>
                                        <Canvas Style="{StaticResource CurledCornerStyle}">
                                            <Path Data="{StaticResource FoldBackGeometry}" Fill="#30000000"/>
                                            <Path Data="{StaticResource FoldFrontGeometry}">
                                                <Path.Fill>
                                                    <LinearGradientBrush StartPoint="0,1" EndPoint="1,0">
                                                        <GradientStop Color="#A0000000" Offset="0"/>
                                                        <GradientStop Color="#60000000" Offset="0.3"/>
                                                        <GradientStop Color="#30000000" Offset="0.6"/>
                                                        <GradientStop Color="Transparent" Offset="1"/>
                                                    </LinearGradientBrush>
                                                </Path.Fill>
                                                <Path.Effect>
                                                    <DropShadowEffect Color="#80000000" Direction="315" ShadowDepth="3" Opacity="0.6" BlurRadius="5"/>
                                                </Path.Effect>
                                            </Path>
                                        </Canvas>
                                    </Grid>
                                </Border>
                                <Ellipse Style="{StaticResource PushPinStyle}" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,-6,0,0"/>
                            </Grid>

                            <!-- Successful Uploads -->
                            <Grid>
                                <Border Style="{StaticResource StatusCardStyle3}">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#F39C12" Offset="0"/>
                                            <GradientStop Color="#E67E22" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <Grid>
                                        <StackPanel>
                                            <TextBlock Text="{Binding StatusSuccessUploads}" Style="{StaticResource LabelStyle}" Foreground="White" Opacity="0.9"/>
                                            <TextBlock Text="{Binding StatusViewModel.SuccessfulUploads}" Style="{StaticResource ValueStyle}" Foreground="White" FontSize="32"/>
                                        </StackPanel>
                                        <Canvas Style="{StaticResource CurledCornerStyle}">
                                            <Path Data="{StaticResource FoldBackGeometry}" Fill="#30000000"/>
                                            <Path Data="{StaticResource FoldFrontGeometry}">
                                                <Path.Fill>
                                                    <LinearGradientBrush StartPoint="0,1" EndPoint="1,0">
                                                        <GradientStop Color="#A0000000" Offset="0"/>
                                                        <GradientStop Color="#60000000" Offset="0.3"/>
                                                        <GradientStop Color="#30000000" Offset="0.6"/>
                                                        <GradientStop Color="Transparent" Offset="1"/>
                                                    </LinearGradientBrush>
                                                </Path.Fill>
                                                <Path.Effect>
                                                    <DropShadowEffect Color="#80000000" Direction="315" ShadowDepth="3" Opacity="0.6" BlurRadius="5"/>
                                                </Path.Effect>
                                            </Path>
                                        </Canvas>
                                    </Grid>
                                </Border>
                                <Ellipse Style="{StaticResource PushPinStyle}" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,-6,0,0"/>
                            </Grid>

                            <!-- Queued Uploads -->
                            <Grid>
                                <Border Style="{StaticResource StatusCardStyle}">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#1ABC9C" Offset="0"/>
                                            <GradientStop Color="#16A085" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <Grid>
                                        <StackPanel>
                                            <TextBlock Text="{Binding StatusQueuedItems}" Style="{StaticResource LabelStyle}" Foreground="White" Opacity="0.9"/>
                                            <TextBlock Text="{Binding StatusViewModel.QueuedUploads}" Style="{StaticResource ValueStyle}" Foreground="White" FontSize="32"/>
                                        </StackPanel>
                                        <Canvas Style="{StaticResource CurledCornerStyle}">
                                            <Path Data="{StaticResource FoldBackGeometry}" Fill="#30000000"/>
                                            <Path Data="{StaticResource FoldFrontGeometry}">
                                                <Path.Fill>
                                                    <LinearGradientBrush StartPoint="0,1" EndPoint="1,0">
                                                        <GradientStop Color="#A0000000" Offset="0"/>
                                                        <GradientStop Color="#60000000" Offset="0.3"/>
                                                        <GradientStop Color="#30000000" Offset="0.6"/>
                                                        <GradientStop Color="Transparent" Offset="1"/>
                                                    </LinearGradientBrush>
                                                </Path.Fill>
                                                <Path.Effect>
                                                    <DropShadowEffect Color="#80000000" Direction="315" ShadowDepth="3" Opacity="0.6" BlurRadius="5"/>
                                                </Path.Effect>
                                            </Path>
                                        </Canvas>
                                    </Grid>
                                </Border>
                                <Ellipse Style="{StaticResource PushPinStyle}" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,-6,0,0"/>
                            </Grid>
                        </UniformGrid>

                        <!-- System Info Card -->
                        <Grid Margin="15,20">
                            <Border Style="{StaticResource CardStyle}" Margin="0">

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{Binding StatusUptime}" Style="{StaticResource LabelStyle}"/>
                                    <TextBlock Text="{Binding StatusViewModel.Uptime}" Style="{StaticResource ValueStyle}" FontSize="18" Margin="0,5,0,15"/>

                                    <TextBlock Text="{Binding StatusLastUpdate}" Style="{StaticResource LabelStyle}"/>
                                    <TextBlock Text="{Binding StatusViewModel.LastUpdated, StringFormat='yyyy-MM-dd HH:mm:ss'}"
                                               Style="{StaticResource ValueStyle}" FontSize="14" Margin="0,5,0,0"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding StatusLastError}" Style="{StaticResource LabelStyle}"/>
                                    <TextBlock Text="{Binding StatusViewModel.LastError}"
                                               TextWrapping="Wrap"
                                               Foreground="#E74C3C"
                                               FontSize="13"
                                               Margin="0,5,0,0"/>
                                </StackPanel>
                            </Grid>
                            </Border>
                            <Ellipse Style="{StaticResource PushPinStyle}" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,-6,0,0"/>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Queue Status Tab -->
            <TabItem Header="{Binding TabQueue}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="10">
                    <StackPanel>
                        <TextBlock Text="{Binding QueueSectionTitle}" Style="{StaticResource TitleStyle}" Margin="20,10,0,10"/>
                        <UniformGrid Columns="2" Rows="3" Margin="5,0">
                            <!-- Pending -->
                            <Grid>
                                <Border Style="{StaticResource StatusCardStyle2}">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#3498DB" Offset="0"/>
                                            <GradientStop Color="#2980B9" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <Grid>
                                        <StackPanel>
                                            <TextBlock Text="{Binding QueuePendingTitle}" Style="{StaticResource LabelStyle}" Foreground="White" Opacity="0.9"/>
                                            <TextBlock Text="{Binding QueueViewModel.PendingCount}" Style="{StaticResource ValueStyle}" Foreground="White" FontSize="36"/>
                                        </StackPanel>
                                        <Canvas Style="{StaticResource CurledCornerStyle}">
                                            <Path Data="{StaticResource FoldBackGeometry}" Fill="#30000000"/>
                                            <Path Data="{StaticResource FoldFrontGeometry}">
                                                <Path.Fill>
                                                    <LinearGradientBrush StartPoint="0,1" EndPoint="1,0">
                                                        <GradientStop Color="#A0000000" Offset="0"/>
                                                        <GradientStop Color="#60000000" Offset="0.3"/>
                                                        <GradientStop Color="#30000000" Offset="0.6"/>
                                                        <GradientStop Color="Transparent" Offset="1"/>
                                                    </LinearGradientBrush>
                                                </Path.Fill>
                                                <Path.Effect>
                                                    <DropShadowEffect Color="#80000000" Direction="315" ShadowDepth="3" Opacity="0.6" BlurRadius="5"/>
                                                </Path.Effect>
                                            </Path>
                                        </Canvas>
                                    </Grid>
                                </Border>
                                <Ellipse Style="{StaticResource PushPinStyle}" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,-6,0,0"/>
                            </Grid>

                            <!-- Retrying -->
                            <Grid>
                                <Border Style="{StaticResource StatusCardStyle3}">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#F39C12" Offset="0"/>
                                            <GradientStop Color="#E67E22" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <Grid>
                                        <StackPanel>
                                            <TextBlock Text="{Binding QueueRetryingTitle}" Style="{StaticResource LabelStyle}" Foreground="White" Opacity="0.9"/>
                                            <TextBlock Text="{Binding QueueViewModel.RetryingCount}" Style="{StaticResource ValueStyle}" Foreground="White" FontSize="36"/>
                                        </StackPanel>
                                        <Canvas Style="{StaticResource CurledCornerStyle}">
                                            <Path Data="{StaticResource FoldBackGeometry}" Fill="#30000000"/>
                                            <Path Data="{StaticResource FoldFrontGeometry}">
                                                <Path.Fill>
                                                    <LinearGradientBrush StartPoint="0,1" EndPoint="1,0">
                                                        <GradientStop Color="#A0000000" Offset="0"/>
                                                        <GradientStop Color="#60000000" Offset="0.3"/>
                                                        <GradientStop Color="#30000000" Offset="0.6"/>
                                                        <GradientStop Color="Transparent" Offset="1"/>
                                                    </LinearGradientBrush>
                                                </Path.Fill>
                                                <Path.Effect>
                                                    <DropShadowEffect Color="#80000000" Direction="315" ShadowDepth="3" Opacity="0.6" BlurRadius="5"/>
                                                </Path.Effect>
                                            </Path>
                                        </Canvas>
                                    </Grid>
                                </Border>
                                <Ellipse Style="{StaticResource PushPinStyle}" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,-6,0,0"/>
                            </Grid>

                            <!-- Failed -->
                            <Grid>
                                <Border Style="{StaticResource StatusCardStyle}">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#E74C3C" Offset="0"/>
                                            <GradientStop Color="#C0392B" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <Grid>
                                        <StackPanel>
                                            <TextBlock Text="{Binding QueueFailedTitle}" Style="{StaticResource LabelStyle}" Foreground="White" Opacity="0.9"/>
                                            <TextBlock Text="{Binding QueueViewModel.FailedCount}" Style="{StaticResource ValueStyle}" Foreground="White" FontSize="36"/>
                                        </StackPanel>
                                        <Canvas Style="{StaticResource CurledCornerStyle}">
                                            <Path Data="{StaticResource FoldBackGeometry}" Fill="#30000000"/>
                                            <Path Data="{StaticResource FoldFrontGeometry}">
                                                <Path.Fill>
                                                    <LinearGradientBrush StartPoint="0,1" EndPoint="1,0">
                                                        <GradientStop Color="#A0000000" Offset="0"/>
                                                        <GradientStop Color="#60000000" Offset="0.3"/>
                                                        <GradientStop Color="#30000000" Offset="0.6"/>
                                                        <GradientStop Color="Transparent" Offset="1"/>
                                                    </LinearGradientBrush>
                                                </Path.Fill>
                                                <Path.Effect>
                                                    <DropShadowEffect Color="#80000000" Direction="315" ShadowDepth="3" Opacity="0.6" BlurRadius="5"/>
                                                </Path.Effect>
                                            </Path>
                                        </Canvas>
                                    </Grid>
                                </Border>
                                <Ellipse Style="{StaticResource PushPinStyle}" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,-6,0,0"/>
                            </Grid>

                            <!-- Total Depth -->
                            <Grid>
                                <Border Style="{StaticResource StatusCardStyle2}">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#9B59B6" Offset="0"/>
                                            <GradientStop Color="#8E44AD" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <Grid>
                                        <StackPanel>
                                            <TextBlock Text="{Binding QueueTotalDepthTitle}" Style="{StaticResource LabelStyle}" Foreground="White" Opacity="0.9"/>
                                            <TextBlock Text="{Binding QueueViewModel.TotalDepth}" Style="{StaticResource ValueStyle}" Foreground="White" FontSize="36"/>
                                        </StackPanel>
                                        <Canvas Style="{StaticResource CurledCornerStyle}">
                                            <Path Data="{StaticResource FoldBackGeometry}" Fill="#30000000"/>
                                            <Path Data="{StaticResource FoldFrontGeometry}">
                                                <Path.Fill>
                                                    <LinearGradientBrush StartPoint="0,1" EndPoint="1,0">
                                                        <GradientStop Color="#A0000000" Offset="0"/>
                                                        <GradientStop Color="#60000000" Offset="0.3"/>
                                                        <GradientStop Color="#30000000" Offset="0.6"/>
                                                        <GradientStop Color="Transparent" Offset="1"/>
                                                    </LinearGradientBrush>
                                                </Path.Fill>
                                                <Path.Effect>
                                                    <DropShadowEffect Color="#80000000" Direction="315" ShadowDepth="3" Opacity="0.6" BlurRadius="5"/>
                                                </Path.Effect>
                                            </Path>
                                        </Canvas>
                                    </Grid>
                                </Border>
                                <Ellipse Style="{StaticResource PushPinStyle}" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,-6,0,0"/>
                            </Grid>
                        </UniformGrid>

                        <!-- Oldest Queued Info -->
                        <Grid Margin="15,20">
                            <Border Style="{StaticResource CardStyle}" Margin="0">

                                <StackPanel>
                                    <TextBlock Text="{Binding QueueOldestItem}" Style="{StaticResource LabelStyle}"/>
                                    <TextBlock Text="{Binding QueueViewModel.OldestQueuedAt}"
                                               Style="{StaticResource ValueStyle}"
                                               FontSize="16"
                                               Margin="0,5,0,0"/>
                                </StackPanel>
                            </Border>
                            <Ellipse Style="{StaticResource PushPinStyle}" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,-6,0,0"/>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Upload History Tab -->
            <TabItem Header="{Binding TabHistory}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Refresh Button -->
                    <Border Grid.Row="0" Background="White" Padding="15" Margin="15,15,15,0" CornerRadius="8,8,0,0">
                        <Button Content="{Binding HistoryRefreshButton}"
                                Command="{Binding HistoryViewModel.RefreshCommand}"
                                Style="{StaticResource ModernButtonStyle}"
                                HorizontalAlignment="Right"/>
                    </Border>

                    <!-- Sub-Tab Control for Two History Views -->
                    <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="15,0,15,15" Padding="10" CornerRadius="0,0,8,8">
                        <TabControl>
                            <!-- Equipment → Middleware History -->
                            <TabItem Header="{Binding HistoryEquipmentToMiddlewareTab}">
                                <DataGrid ItemsSource="{Binding HistoryViewModel.EquipmentToMiddlewareRecords}"
                                          IsReadOnly="True"
                                          Margin="0,10,0,0">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="{Binding DataContext.HistoryHeaderTimestamp, RelativeSource={RelativeSource AncestorType=Window}}" Binding="{Binding Timestamp, StringFormat='yyyy-MM-dd HH:mm:ss'}" Width="160"/>
                                        <DataGridTextColumn Header="{Binding DataContext.HistoryHeaderTraceCode, RelativeSource={RelativeSource AncestorType=Window}}" Binding="{Binding TraceCode}" Width="150"/>
                                        <DataGridTextColumn Header="{Binding DataContext.HistoryHeaderEquipmentName, RelativeSource={RelativeSource AncestorType=Window}}" Binding="{Binding EquipmentName}" Width="130"/>
                                        <DataGridTextColumn Header="{Binding DataContext.HistoryHeaderStatus, RelativeSource={RelativeSource AncestorType=Window}}" Binding="{Binding Status}" Width="100"/>
                                        <DataGridTextColumn Header="{Binding DataContext.HistoryHeaderErrorMessage, RelativeSource={RelativeSource AncestorType=Window}}" Binding="{Binding ErrorMessage}" Width="*"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </TabItem>

                            <!-- Middleware → MES Cloud History -->
                            <TabItem Header="{Binding HistoryMiddlewareToMesTab}">
                                <DataGrid ItemsSource="{Binding HistoryViewModel.MiddlewareToMesRecords}"
                                          IsReadOnly="True"
                                          Margin="0,10,0,0">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="{Binding DataContext.HistoryHeaderUploadTime, RelativeSource={RelativeSource AncestorType=Window}}" Binding="{Binding Timestamp, StringFormat='yyyy-MM-dd HH:mm:ss'}" Width="160"/>
                                        <DataGridTextColumn Header="{Binding DataContext.HistoryHeaderTraceCode, RelativeSource={RelativeSource AncestorType=Window}}" Binding="{Binding TraceCode}" Width="150"/>
                                        <DataGridTextColumn Header="{Binding DataContext.HistoryHeaderEquipmentName, RelativeSource={RelativeSource AncestorType=Window}}" Binding="{Binding EquipmentName}" Width="130"/>
                                        <DataGridTextColumn Header="{Binding DataContext.HistoryHeaderStatus, RelativeSource={RelativeSource AncestorType=Window}}" Binding="{Binding Status}" Width="100"/>
                                        <DataGridTextColumn Header="{Binding DataContext.HistoryHeaderErrorMessage, RelativeSource={RelativeSource AncestorType=Window}}" Binding="{Binding ErrorMessage}" Width="*"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </TabItem>
                        </TabControl>
                    </Border>
                </Grid>
            </TabItem>

            <!-- Trace Verification Tab -->
            <TabItem Header="{Binding TabTraceVerification}">
                <views:TraceVerificationView DataContext="{Binding TraceVerificationViewModel}"/>
            </TabItem>
        </TabControl>
            </Grid>
        </Border>
        </Grid>
    </Grid>
</Window>
