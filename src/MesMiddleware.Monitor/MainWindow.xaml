<Window x:Class="MesMiddleware.Monitor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MesMiddleware.Monitor"
        xmlns:tb="http://www.hardcodet.net/taskbar"
        mc:Ignorable="d"
        Title="MES Middleware Monitor" Height="600" Width="1000"
        Closing="Window_Closing"
        StateChanged="Window_StateChanged">

    <Window.Resources>
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Padding" Value="10"/>
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="Margin" Value="5,2"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#2196F3" Padding="15">
            <TextBlock Text="MES Middleware Monitoring Dashboard"
                       FontSize="20"
                       FontWeight="Bold"
                       Foreground="White"/>
        </Border>

        <!-- Main Content -->
        <TabControl Grid.Row="1" Margin="10">
            <TabItem Header="Status">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <GroupBox Header="Service Status">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Service Running:" FontWeight="Bold"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding StatusViewModel.IsRunning}"/>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="WebAPI Connected:" FontWeight="Bold"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding StatusViewModel.IsWebApiConnected}"/>

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Shared Memory Active:" FontWeight="Bold"/>
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding StatusViewModel.IsSharedMemoryActive}"/>

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Uptime:" FontWeight="Bold"/>
                                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding StatusViewModel.Uptime}"/>

                                <TextBlock Grid.Row="4" Grid.Column="0" Text="Last Updated:" FontWeight="Bold"/>
                                <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding StatusViewModel.LastUpdated, StringFormat='yyyy-MM-dd HH:mm:ss'}"/>

                                <TextBlock Grid.Row="5" Grid.Column="0" Text="Last Error:" FontWeight="Bold"/>
                                <TextBlock Grid.Row="5" Grid.Column="1"
                                           Text="{Binding StatusViewModel.LastError}"
                                           Foreground="Red"
                                           TextWrapping="Wrap"/>
                            </Grid>
                        </GroupBox>

                        <GroupBox Header="Statistics">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Total Data Received:" FontWeight="Bold"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding StatusViewModel.TotalDataReceived}"/>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Successful Uploads:" FontWeight="Bold"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding StatusViewModel.SuccessfulUploads}"/>

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Queued Uploads:" FontWeight="Bold"/>
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding StatusViewModel.QueuedUploads}"/>
                            </Grid>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Queue Status">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <GroupBox Header="Upload Queue">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Pending:" FontWeight="Bold"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding QueueViewModel.PendingCount}"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Retrying:" FontWeight="Bold"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding QueueViewModel.RetryingCount}"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Failed:" FontWeight="Bold"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding QueueViewModel.FailedCount}" Foreground="Red"/>

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Total Depth:" FontWeight="Bold"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding QueueViewModel.TotalDepth}"/>

                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Oldest Queued:" FontWeight="Bold"/>
                            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding QueueViewModel.OldestQueuedAt}"/>
                        </Grid>
                    </GroupBox>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Upload History">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Button Grid.Row="0"
                            Content="Refresh"
                            Command="{Binding HistoryViewModel.RefreshCommand}"
                            Margin="10"
                            Padding="10,5"
                            HorizontalAlignment="Right"/>

                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding HistoryViewModel.HistoryItems}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              Margin="10">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Timestamp" Binding="{Binding Timestamp, StringFormat='yyyy-MM-dd HH:mm:ss'}" Width="150"/>
                            <DataGridTextColumn Header="Trace/Lot No" Binding="{Binding TraceCodeOrLotNo}" Width="150"/>
                            <DataGridTextColumn Header="Device" Binding="{Binding DeviceName}" Width="120"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100"/>
                            <DataGridTextColumn Header="Retry Count" Binding="{Binding RetryCount}" Width="100"/>
                            <DataGridTextColumn Header="Error" Binding="{Binding ErrorMessage}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
