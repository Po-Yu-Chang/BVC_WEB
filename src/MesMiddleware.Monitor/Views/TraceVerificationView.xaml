<UserControl x:Class="MesMiddleware.Monitor.Views.TraceVerificationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:MesMiddleware.Monitor.Views"
             xmlns:vm="clr-namespace:MesMiddleware.Monitor.ViewModels"
             xmlns:converters="clr-namespace:MesMiddleware.Monitor.Converters"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="1000"
             d:DataContext="{d:DesignInstance Type=vm:TraceVerificationViewModel}"
             Background="#F5F7FA">

    <UserControl.Resources>
        <!-- 本地轉換器 -->
        <converters:InverseBooleanConverter x:Key="InverseBooleanConverter"/>

        <!-- 緊湊型卡片樣式 -->
        <Style x:Key="CompactCardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="10"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#CBD5E1" BlurRadius="15" ShadowDepth="3" Opacity="0.12" Direction="270"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 標題樣式 -->
        <Style x:Key="TitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#1E40AF"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <!-- 副標題樣式 -->
        <Style x:Key="SubtitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="Margin" Value="0,0,0,0"/>
        </Style>

        <!-- 標籤樣式 -->
        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <!-- 緊湊型輸入框樣式 -->
        <Style x:Key="CompactTextBoxStyle" TargetType="TextBox">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#1E293B"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost"
                                        Padding="{TemplateBinding Padding}"
                                        VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsFocused" Value="True">
                    <Setter Property="BorderBrush" Value="#3B82F6"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="#94A3B8"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 多行輸入框樣式 -->
        <Style x:Key="CompactMultilineTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource CompactTextBoxStyle}">
            <Setter Property="Height" Value="70"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="AcceptsReturn" Value="True"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="VerticalContentAlignment" Value="Top"/>
        </Style>

        <!-- 主按鈕樣式 -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#10B981"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="24,10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="MinWidth" Value="120"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#059669"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#047857"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#E5E7EB"/>
                    <Setter Property="Foreground" Value="#9CA3AF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 次要按鈕樣式 -->
        <Style x:Key="SecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
            <Setter Property="Background" Value="#F1F5F9"/>
            <Setter Property="Foreground" Value="#475569"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E2E8F0"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#CBD5E1"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 統計卡片樣式 -->
        <Style x:Key="StatCardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="15"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#CBD5E1" BlurRadius="10" ShadowDepth="2" Opacity="0.1"/>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!-- 改用 Grid 而非 ScrollViewer，避免捲動 -->
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 標題區 (緊湊版) -->
        <Border Grid.Row="0" Style="{StaticResource CompactCardStyle}" Padding="12,10" Margin="8">
            <StackPanel>
                <TextBlock Text="{Binding DataContext.TraceVerificationPageTitle, RelativeSource={RelativeSource AncestorType=Window}}"
                           Style="{StaticResource TitleStyle}"/>
                <TextBlock Text="{Binding DataContext.TraceVerificationPageDescription, RelativeSource={RelativeSource AncestorType=Window}}"
                           Style="{StaticResource SubtitleStyle}"/>
            </StackPanel>
        </Border>

        <!-- 主要內容區 - 使用 Grid 分兩欄 -->
        <Grid Grid.Row="1" Margin="8,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 左側：輸入區 -->
            <Border Grid.Column="0" Style="{StaticResource CompactCardStyle}" Margin="0,0,4,0" Padding="15,12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 工單號輸入 -->
                    <StackPanel Grid.Row="0">
                        <TextBlock Text="{Binding DataContext.TraceVerificationWorkOrderLabel, RelativeSource={RelativeSource AncestorType=Window}}"
                                   Style="{StaticResource LabelStyle}"/>
                        <TextBox x:Name="WorkOrderTextBox"
                                 Text="{Binding WorkOrderNumber, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource CompactTextBoxStyle}"
                                 IsReadOnly="{Binding IsVerifying}">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding VerifyCommand}"/>
                            </TextBox.InputBindings>
                        </TextBox>
                    </StackPanel>

                    <!-- 板號輸入 -->
                    <StackPanel Grid.Row="1">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="{Binding DataContext.TraceVerificationTraceCodeLabel, RelativeSource={RelativeSource AncestorType=Window}}"
                                       Style="{StaticResource LabelStyle}"
                                       Margin="0"/>
                            <TextBlock Text="{Binding DataContext.TraceVerificationTraceCodeHint, RelativeSource={RelativeSource AncestorType=Window}}"
                                       FontSize="11"
                                       Foreground="#94A3B8"
                                       Margin="8,0,0,0"
                                       VerticalAlignment="Bottom"/>
                        </StackPanel>
                        <TextBox x:Name="TraceCodeTextBox"
                                 Text="{Binding TraceCodes, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource CompactMultilineTextBoxStyle}"
                                 IsReadOnly="{Binding IsVerifying}">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Enter" Modifiers="Ctrl" Command="{Binding VerifyCommand}"/>
                            </TextBox.InputBindings>
                        </TextBox>
                    </StackPanel>

                    <!-- 按鈕區 -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,5,0,0">
                        <Button Content="{Binding DataContext.TraceVerificationClearButton, RelativeSource={RelativeSource AncestorType=Window}}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding ClearCommand}"
                                Margin="0,0,10,0"/>
                        <Button Content="{Binding DataContext.TraceVerificationVerifyButton, RelativeSource={RelativeSource AncestorType=Window}}"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Command="{Binding VerifyCommand}"
                                IsEnabled="{Binding IsVerifying, Converter={StaticResource InverseBooleanConverter}}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 右側：結果顯示區 -->
            <Border Grid.Column="1" Style="{StaticResource CompactCardStyle}" Margin="4,0,0,0" Padding="15,12">
                <StackPanel>
                    <TextBlock Text="{Binding DataContext.TraceVerificationResultTitle, RelativeSource={RelativeSource AncestorType=Window}}"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="#1E293B"
                               Margin="0,0,0,10"/>

                    <!-- 動態結果框 -->
                    <Border MinHeight="100" CornerRadius="6" Padding="12">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ResultStatus}" Value="success">
                                        <Setter Property="Background" Value="#D1FAE5"/>
                                        <Setter Property="BorderBrush" Value="#10B981"/>
                                        <Setter Property="BorderThickness" Value="2"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ResultStatus}" Value="error">
                                        <Setter Property="Background" Value="#FEE2E2"/>
                                        <Setter Property="BorderBrush" Value="#EF4444"/>
                                        <Setter Property="BorderThickness" Value="2"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ResultStatus}" Value="idle">
                                        <Setter Property="Background" Value="#F8FAFC"/>
                                        <Setter Property="BorderBrush" Value="#E2E8F0"/>
                                        <Setter Property="BorderThickness" Value="1"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>

                        <TextBlock Text="{Binding ResultMessage}"
                                   FontSize="14"
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ResultStatus}" Value="success">
                                            <Setter Property="Foreground" Value="#065F46"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding ResultStatus}" Value="error">
                                            <Setter Property="Foreground" Value="#991B1B"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding ResultStatus}" Value="idle">
                                            <Setter Property="Foreground" Value="#64748B"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>

        <!-- 統計區 (底部) -->
        <Border Grid.Row="2" Style="{StaticResource CompactCardStyle}" Padding="15,10" Margin="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="{Binding DataContext.TraceVerificationStatisticsTitle, RelativeSource={RelativeSource AncestorType=Window}}"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Foreground="#1E293B"
                           VerticalAlignment="Center"/>

                <UniformGrid Grid.Column="1" Rows="1" Columns="3" Margin="15,0">
                    <!-- 成功次數 -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,12,0">
                        <TextBlock Text="{Binding DataContext.TraceVerificationSuccessCount, RelativeSource={RelativeSource AncestorType=Window}}"
                                   FontSize="12"
                                   Foreground="#10B981"
                                   FontWeight="Medium"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0"/>
                        <TextBlock Text="{Binding SuccessCount}"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="#10B981"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- 失敗次數 -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,12,0">
                        <TextBlock Text="{Binding DataContext.TraceVerificationFailureCount, RelativeSource={RelativeSource AncestorType=Window}}"
                                   FontSize="12"
                                   Foreground="#EF4444"
                                   FontWeight="Medium"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0"/>
                        <TextBlock Text="{Binding FailureCount}"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="#EF4444"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- 最後驗證時間 -->
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding DataContext.TraceVerificationLastVerification, RelativeSource={RelativeSource AncestorType=Window}}"
                                   FontSize="12"
                                   Foreground="#3B82F6"
                                   FontWeight="Medium"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0"/>
                        <TextBlock FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="#3B82F6"
                                   VerticalAlignment="Center">
                            <TextBlock.Text>
                                <MultiBinding StringFormat="{}{0:HH:mm:ss}">
                                    <Binding Path="LastVerificationTime"/>
                                </MultiBinding>
                            </TextBlock.Text>
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding LastVerificationTime}" Value="{x:Null}">
                                            <Setter Property="Text" Value="{Binding DataContext.TraceVerificationNoVerification, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                            <Setter Property="Foreground" Value="#94A3B8"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </UniformGrid>

                <Button Grid.Column="2"
                        Content="{Binding DataContext.TraceVerificationResetStatistics, RelativeSource={RelativeSource AncestorType=Window}}"
                        Command="{Binding ResetStatisticsCommand}"
                        Padding="12,6"
                        FontSize="12"
                        Background="#F1F5F9"
                        Foreground="#475569"
                        BorderThickness="0"
                        Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    CornerRadius="4"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </Border>
    </Grid>
</UserControl>
