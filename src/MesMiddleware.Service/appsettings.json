{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/middleware-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 7,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [ "WithMachineName", "WithThreadId" ],
    "Properties": {
      "Application": "MesMiddleware"
    }
  },
  "SharedMemory": {
    "InspectionDataSegmentName": "MES_INSPECTION_DATA",
    "EquipmentCommandSegmentName": "MES_EQUIPMENT_CMD",
    "DataReadyEventName": "MES_DATA_READY",
    "CommandReadyEventName": "MES_CMD_READY",
    "SegmentSize": 10485760,
    "MutexTimeout": 5000
  },
  "WebApi": {
    "BaseUrl": "http://localhost:5000",
    "Timeout": 30,
    "MachineNumber": "MACHINE001",
    "MachineIp": "192.168.1.100"
  },
  "Resilience": {
    "Retry": {
      "MaxRetryAttempts": 5,
      "InitialDelay": 2,
      "BackoffType": "Exponential"
    },
    "CircuitBreaker": {
      "FailureRatio": 0.5,
      "SamplingDuration": 30,
      "MinimumThroughput": 10,
      "BreakDuration": 60
    }
  },
  "Queue": {
    "DatabasePath": "Data/queue.db",
    "MaxQueueSize": 10000,
    "RetryBatchSize": 100,
    "RetryInterval": 60
  }
}
